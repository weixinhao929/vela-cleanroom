{
  "name": "vela-cleanroom",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "version": "0.1.0",
  "license": "MIT",
  "author": "浩浩浩",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm --prefix e2e run test",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "lint:anim": "node scripts/check-will-change.mjs && node scripts/check-transitions.mjs && node scripts/check-fx-gate.mjs && node scripts/check-js-anim.mjs && node scripts/check-layout-anim.mjs --strict",
    "lint:anim:baseline": "node scripts/check-transitions.mjs --update-baseline",
    "lint:sizes": "node scripts/check-size-tokens.mjs",
    "lint:layout-anim": "node scripts/check-layout-anim.mjs",
    "lint:tokens": "node scripts/check-css-tokens.mjs",
    "lint:i18n": "node scripts/check-i18n.cjs && node scripts/check-i18n-attrs.cjs && node scripts/check-i18n.cjs --dead",
    "lint:ime": "node scripts/check-ime-guards.mjs",
    "lint:api": "node scripts/check-api-docs.mjs",
    "lint:layering": "node scripts/check-layering.mjs",
    "lint:window-gates": "node scripts/check-window-gates.mjs",
    "lint:csp": "node scripts/check-csp-lock.mjs",
    "gen:types": "cd src-tauri && cargo test export",
    "ci:local": "node scripts/run-local-ci.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-notification": "^2.3.0",
    "lucide-react": "^0.468.0",
    "motion": "^13.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tauri-apps/cli": "^2.8.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.11"
  }
}
